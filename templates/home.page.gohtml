{{template "base" .}}

{{define "title"}}<title>HOME</title>{{end}}

{{define "content"}}
    <div class="container">
        <div class="row">
            <div class="col">
                <h1>This is the Home</h1>
                <p>Sample text</p>
                <!--TemplateDatayı handle function ile yollamıştık burada aşağıdaki gibi çözümleriz.-->
                <p>This came from the template : {{index .StringMap "test"}}</p>
                <p> <!--if index.StringMap["remote_ip"] != ""-->
                    {{if ne (index .StringMap "remote_ip") ""}}
                        Your remote IP address is {{index .StringMap "remote_ip"}}
                    {{else}}
                        I don't know your IP adress. Visit the <a href="/">Home Page</a> so I can set it.
                    {{end}}
                </p>
                <img src="/static/images/house.jpg">
            </div>
        </div>
    </div>
{{end}}