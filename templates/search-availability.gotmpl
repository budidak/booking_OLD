{{template "base" .}}

{{define "title"}}<title>Search Availability</title>{{end}}

{{define "content"}} 
    <!--BODY-->
    <div class="container">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-6">
                <h1 class="mt-3">Search for Availability</h1>
                <!--BOOTSTRAP FORM-->
                <form action="/search-availability" method="post" novalidate class="needs-validation">
                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}"> <!--POST requestlerde CSRF token protection için (CSRF token sayfa her yenilendiğinde farklı değer alır)-->
                    <div class="row">
                        <div class="col">
                            <div class="row" id="reservation-dates">
                                <div class="col-md-6">
                                    <input required class="form-control" type="text" name="start" placeholder="Arrival">
                                </div>
                                <div class="col-md-6">
                                    <input required class="form-control" type="text" name="end" placeholder="Departure">
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <button type="submit" class="btn btn-primary">Search Availability</button>
                </form>
            </div>
            <div class="col-md-3"></div>
        </div>
    </div>
{{end}}

{{define "js"}}
    <script>
        // DATE PICKER JS
        const elem = document.getElementById('reservation-dates');
        const rangePicker = new DateRangePicker(elem, {
            format: "dd-mm-yyyy",
        });
    </script> 
{{end}}